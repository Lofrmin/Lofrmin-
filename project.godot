; PROJECT HELIOS - native Godot prototype
config_version=5

[application]
config/name="逐光计划 · 静默回声"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1600
window/size/viewport_height=960
window/size/window_width_override=1440
window/size/window_height_override=864
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.008, 0.015, 0.035, 1)

[audio]
driver/enable_input=false
